# Copy to .env and fill in. Never commit .env.
# backend/app/config.py also accepts the legacy names noted on the right.

# ---------- App ----------
APP_ENV=development                 # development | production | test
APP_URL=http://localhost:5173       # frontend origin (CORS + share links)
MOCK_MODE=true                      # true = fixtures only, zero YouCam calls
DEFAULT_LOCALE=en
DEFAULT_COUNTRY=IN
DATABASE_URL=postgresql+asyncpg://haan:CHANGE_ME@localhost:5432/haan
TEST_DATABASE_URL=postgresql+asyncpg://haan:CHANGE_ME@localhost:5432/haan_test

# ---------- YouCam / Perfect Corp ----------
YOUCAM_API_KEY=                     # alias: YouCam_Phd_API_KEY
YOUCAM_SECRET_KEY=                  # alias: YouCam_Secret_Key
YOUCAM_API_BASE_URL=                # confirmed value: see docs/API_NOTES.md
YOUCAM_UNIT_BUDGET=900              # hard cap the ledger enforces
YOUCAM_UNIT_RESERVE=150             # never touch: reserved for judging demo
YOUCAM_USE_MCP=false
YOUCAM_MCP_URL=

# ---------- LLM ----------
LLM_PROVIDER=openrouter             # openrouter | anthropic | openai
LLM_MODEL=                          # alias: OPENROUTER_PRIMARY_MODEL_NAME
OPENROUTER_API_KEY=                 # alias: OPENROUTER_API_KEY_1
OPENROUTER_API_KEY_2=               # optional second key (round-robin / fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Speech ----------
STT_PROVIDER=sarvam                 # sarvam | whisper
SARVAM_API_KEY=                     # alias: SARVAM_2009_API_KEY
TTS_ENABLED=false

# ---------- Geo ----------
GEO_REVERSE_PROVIDER=offline        # offline | nominatim
GEO_NEAREST_CITY_MAX_KM=250

# ---------- Integrity / security ----------
INTEGRITY_SHARED_SECRET=
SHARE_TOKEN_SECRET=
STORE_DASHBOARD_PASSWORD=
IMAGE_RETENTION_HOURS=72
